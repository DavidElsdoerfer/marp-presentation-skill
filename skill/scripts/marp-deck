#!/usr/bin/env python3
"""marp-deck — Marp-Decks anlegen, live ansehen und exportieren.

  marp-deck new <titel> [--brand NAME] [--dir ORDNER] [--slug SLUG]
  marp-deck serve [DECK] [--port N] [--stop]
  marp-deck export pdf|html|pptx [DECK] [-o DATEI]
  marp-deck import-deck DATEI.pptx [--brand NAME] [--title T] [--dir ORDNER] [--tool PFAD]   (optional, braucht pptx2md)
  marp-deck suggest TITEL [--project ORDNER] [--date JJJJ-MM-TT] [--json]   (Zielordner und Namen vorschlagen, schreibt nichts)
  marp-deck vscode [PROJEKT] [--dry-run]       (Marp for VS Code: Themes und HTML-Einstellung eintragen)
  marp-deck pack [DECK] [-o DATEI.deck] [--force]
  marp-deck unpack DATEI.deck [--dir ORDNER]
  marp-deck brand list
  marp-deck brand sync [DECK]
  marp-deck brand showcase VORLAGE.pptx [--out ORDNER]
  marp-deck brand import VORLAGE.pptx --name NAME [--backgrounds PDF|ORDNER] [--reference PDF|ORDNER]
                         [--guidelines DATEI]... [--fonts ORDNER] [--map klasse=Layout]... [--no-render] [--replace] [--out ORDNER]
  marp-deck brand preview NAME [--out ORDNER]
  marp-deck brand compare NAME [--out ORDNER]
  marp-deck doctor

DECK ist der Deck-Ordner (Standard: aktueller Ordner oder genau ein Unterordner mit marp.config.mjs).
"""
import argparse, base64, importlib.util, json, mimetypes, os, re, shutil, signal, socket, subprocess, sys, tempfile
import time, unicodedata, urllib.error, urllib.request, zipfile
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote, unquote

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from common import marp_cmd, marp_env, run_marp  # noqa: E402


def _load_build_theme():
    spec = importlib.util.spec_from_file_location("build_theme", HERE / "build-theme.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


bt = _load_build_theme()

CONFIG = """\
// Generiert von marp-deck. Alle Pfade relativ zu diesem Ordner.
export default {
  allowLocalFiles: true,   // ohne diese Option läuft marp-cli beim Seitenladen in einen Timeout
  html: true,
  themeSet: ['./theme/theme.css'],
  pdfNotes: true,
  pdfOutlines: true,
}
"""

DECK_GITIGNORE = "dist/\n.marp-deck/\n"

# Einstellungen für die VS-Code-Erweiterung "Marp for VS Code" (Pfade gelten relativ zum geöffneten Ordner).
# html "all" ist nötig: sonst zeigt die Vorschau unsere <div>-Komponenten als Text.
VSCODE_THEMES_KEY, VSCODE_HTML_KEY = "markdown.marp.themes", "markdown.marp.html"
VSCODE_DEFAULTS = {"markdown.marp.pdf.noteAnnotations": True, "markdown.marp.pdf.outlines": "both"}
VSCODE_SETTINGS = json.dumps({VSCODE_THEMES_KEY: ["theme/theme.css"], VSCODE_HTML_KEY: "all", **VSCODE_DEFAULTS},
                             indent=4, ensure_ascii=False) + "\n"

# Nicht in den Brand-Snapshot eines Decks kopieren (vertrauliche Originale, nur für den Brand-Vergleich nötig)
SNAPSHOT_EXCLUDE = ("guidelines", "reference")

DECK_TEMPLATE = """\
---
marp: true
theme: {theme}
{size_line}paginate: true
html: true
footer: {title}
---

<!-- _class: title -->

# {title_md}
## Untertitel

<div class="title-meta">
  <span>{date}</span>
  <span>Autor · Ort</span>
</div>

---

# Agenda

1. Erster Punkt
2. Zweiter Punkt
3. Dritter Punkt

---

<!-- _class: section -->

# Erster Abschnitt
## 1

---

# Inhaltsfolie

- Kernaussage
- Beleg oder Beispiel
- Nächster Schritt

<!-- Sprechernotiz: erscheint in der Presenter View und (mit --pdf-notes) im PDF. -->

---

<!-- _class: closing -->

# Fragen?

## kontakt@example.org

Weitere Informationen
"""

MONTHS = ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober",
          "November", "Dezember"]


SAFE_NAME = re.compile(r"^[\w][\w.\-]*$", re.UNICODE)


def check_name(value, what):
    if not value or not SAFE_NAME.match(value) or ".." in value:
        die(f"unzulässiger {what}: {value!r} (erlaubt: Buchstaben, Ziffern, _ . -)")
    return value


def die(msg):
    sys.exit(f"marp-deck: {msg}")


def yaml_text(text):
    """Text als YAML-Zeichenkette in Anführungszeichen (Backslash, Anführungszeichen, Zeilenumbrüche sicher)."""
    return json.dumps(" ".join(str(text).split()), ensure_ascii=False)


def slugify(title, lower=True):
    s = unicodedata.normalize("NFC", title).strip()
    s = s.lower() if lower else s
    s = re.sub(r"\s+", "-", s)
    s = re.sub(r"[^\w\-]", "", s, flags=re.UNICODE).replace("_", "-")
    s = re.sub(r"-{2,}", "-", s).strip("-")
    return s


def find_deck(arg=None):
    base = Path(arg).expanduser() if arg else Path.cwd()
    if (base / "marp.config.mjs").is_file():
        return base.resolve()
    if arg is None:
        subs = [p for p in base.iterdir() if p.is_dir() and (p / "marp.config.mjs").is_file()]
        if len(subs) == 1:
            return subs[0].resolve()
        if len(subs) > 1:
            die("mehrere Decks gefunden, DECK angeben: " + ", ".join(p.name for p in sorted(subs)))
    die(f"kein Deck gefunden in {base} (marp.config.mjs fehlt)")


def ensure_trusted_config(deck, trust=False):
    """marp.config.mjs ist ein JS-Modul und wird von marp-cli ausgeführt. Nur die generierte Standard-Config ist vertrauenswürdig."""
    cfg = deck / "marp.config.mjs"
    if trust or (cfg.is_file() and cfg.read_text() == CONFIG):
        return
    die(f"{cfg} weicht von der generierten Standard-Config ab. marp-cli führt diese Datei als Code aus.\n"
        "  Quelle prüfen und mit --trust-config fortfahren, oder `marp-deck repair-config <deck>` stellt die Standard-Config wieder her.")


def cmd_repair_config(a):
    deck = find_deck(a.deck)
    (deck / "marp.config.mjs").write_text(CONFIG)
    print(f"Standard-Config wiederhergestellt: {deck / 'marp.config.mjs'}")


def deck_md(deck):
    named = deck / f"{deck.name}.md"
    if named.is_file():
        return named
    mds = [p for p in deck.glob("*.md") if p.name.lower() != "readme.md"]
    if len(mds) == 1:
        return mds[0]
    die(f"{deck}: Deck-Datei nicht eindeutig (erwarte {deck.name}.md)")


def differs(src, dst):
    """Dateien, die im Deck-Snapshot anders sind als in der Quelle (oder nur dort existieren)."""
    src, dst = Path(src), Path(dst)
    out = []
    for p in sorted(dst.rglob("*")):
        if p.is_file():
            rel = p.relative_to(dst)
            q = src / rel
            if not q.is_file() or q.read_bytes() != p.read_bytes():
                out.append(rel.as_posix())
    return out


def snapshot_brand(src, deck):
    dst = deck / "theme" / "brand"
    if Path(src).resolve() != dst.resolve():  # Snapshot nie über sich selbst kopieren
        if dst.exists():
            changed = differs(src, dst)
            if changed:   # Handänderungen im Deck nicht stillschweigend verwerfen
                backup = deck / ".marp-deck" / f"brand-backup-{time.strftime('%Y%m%d-%H%M%S')}"
                backup.parent.mkdir(exist_ok=True)
                shutil.copytree(dst, backup, symlinks=True)
                print(f"WARNUNG: Änderungen im Deck-Snapshot ersetzt ({', '.join(changed[:5])}"
                      f"{' …' if len(changed) > 5 else ''}); Sicherung: {backup}", file=sys.stderr)
            shutil.rmtree(dst)
        # Nur, was zum Bauen und Schreiben nötig ist: Original-Richtlinien (guidelines/) und Referenzbilder (reference/)
        # bleiben im Brand-Store, damit ein weitergegebenes Deck sie nicht mitnimmt.
        src_root = Path(src).resolve()

        def ignore(d, names):  # Ausschluss nur auf oberster Ebene des Brands (assets/reference/ o. ä. bleibt erhalten)
            return [n for n in names if Path(d).resolve() == src_root and n in SNAPSHOT_EXCLUDE]

        shutil.copytree(src, dst, ignore=ignore, symlinks=True)
        for p in list(dst.rglob("*")):                  # Symlinks nie ins Deck übernehmen (würden Ziele fremder Dateien offenlegen)
            if p.is_symlink():
                p.unlink()
    bt.build(dst.resolve(), deck / "theme" / "theme.css")


# ── new ────────────────────────────────────────────────────────────────────

def cmd_new(a):
    title = " ".join(a.title).strip()
    if not title:
        die("Titel angeben")
    slug = a.slug or slugify(title)
    if not slug:
        die("aus dem Titel ließ sich kein Dateiname ableiten, --slug angeben")
    check_name(slug, "Deck-Name")
    parent = Path(a.dir).expanduser() if a.dir else Path.cwd()
    deck = (parent / slug).resolve()
    if deck.exists():
        die(f"{deck} existiert bereits")
    src = bt.resolve(a.brand, None)
    deck.mkdir(parents=True)                       # existierte vorher nicht (oben geprüft) → bei Fehlern wieder entfernen
    try:
        (deck / "assets").mkdir()
        (deck / "assets" / ".gitkeep").write_text("")
        snapshot_brand(src, deck)
        brand_meta = json.loads((deck / "theme" / "brand" / "brand.json").read_text())
        theme = brand_meta["name"]
        size_line = f"size: {brand_meta['size']['name']}\n" if brand_meta.get("size") else ""
        now = time.localtime()
        (deck / "marp.config.mjs").write_text(CONFIG)
        (deck / ".gitignore").write_text(DECK_GITIGNORE)
        (deck / ".vscode").mkdir()
        (deck / ".vscode" / "settings.json").write_text(VSCODE_SETTINGS)
        (deck / f"{slug}.md").write_text(DECK_TEMPLATE.format(
            theme=theme, size_line=size_line, title=yaml_text(title), title_md=" ".join(title.split()),
            date=f"{MONTHS[now.tm_mon - 1]} {now.tm_year}"))
    except BaseException:
        shutil.rmtree(deck, ignore_errors=True)
        raise
    print(f"Deck angelegt: {deck}")
    print(f"  Quelle:  {deck / (slug + '.md')}")
    print(f"  Brand:   {theme} (aus {src}; Snapshot in theme/brand/)")
    print(f"  Vorschau: {Path(sys.argv[0]).name} serve {deck}")
    if not getattr(a, "no_vscode", False):
        auto_register(deck)


# ── serve ──────────────────────────────────────────────────────────────────

def free_port(start=8080):
    for p in range(start, start + 200):
        with socket.socket() as s:
            if s.connect_ex(("127.0.0.1", p)) != 0:
                return p
    die("kein freier Port gefunden")


def http_ok(url, timeout=2):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def read_state(deck):
    """serve.json lesen und strikt validieren (Datei kann aus einem fremden Archiv stammen)."""
    f = deck / ".marp-deck" / "serve.json"
    if not f.is_file():
        return None
    try:
        st = json.loads(f.read_text())
        pid, port = st["pid"], st["port"]
    except (ValueError, KeyError, TypeError):
        return None
    if not (isinstance(pid, int) and not isinstance(pid, bool) and pid > 1 and isinstance(port, int)
            and not isinstance(port, bool) and 1 <= port <= 65535):
        return None
    return {"pid": pid, "port": port, "url": f"http://localhost:{port}/{quote(deck_md(deck).name)}"}


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def is_our_server(pid):
    """PID gehört wirklich zu einem von uns gestarteten marp-cli-Server (Schutz vor recycelten PIDs und fremden Zuständen)."""
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        return "marp" in cmd and os.getpgid(pid) == pid
    except OSError:
        return False


def cmd_serve(a):
    deck = find_deck(a.deck)
    if not a.stop:
        ensure_trusted_config(deck, a.trust_config)
    state_dir = deck / ".marp-deck"
    state = read_state(deck)
    running = bool(state) and pid_alive(state["pid"]) and is_our_server(state["pid"]) and http_ok(f"http://127.0.0.1:{state['port']}/")

    if a.stop:
        if state and pid_alive(state["pid"]) and is_our_server(state["pid"]):
            try:
                os.killpg(state["pid"], signal.SIGTERM)
            except OSError:
                pass
            for _ in range(50):
                if not pid_alive(state["pid"]):
                    break
                time.sleep(0.1)
            print(f"Server gestoppt (Port {state['port']})")
        else:
            print("Kein Server aktiv" + (" (veralteter oder fremder Zustand ignoriert)" if state else ""))
        (state_dir / "serve.json").unlink(missing_ok=True)
        return

    md = deck_md(deck)
    if running:
        print(f"Server läuft bereits: {state['url']}")
        return

    port = a.port or free_port(8080)
    with socket.socket() as probe:
        if probe.connect_ex(("127.0.0.1", port)) == 0:
            die(f"Port {port} ist belegt")
    state_dir.mkdir(exist_ok=True)
    env = marp_env()
    env["PORT"] = str(port)
    env["NODE_OPTIONS"] = (env.get("NODE_OPTIONS", "") + f' --require "{HERE / "bind-localhost.cjs"}"').strip()
    log = open(state_dir / "serve.log", "w")
    proc = subprocess.Popen(marp_cmd() + ["-c", "marp.config.mjs", "-s", "."], cwd=deck, env=env,
                            stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    base = f"http://127.0.0.1:{port}/"
    deadline = time.time() + 120
    while time.time() < deadline:
        if proc.poll() is not None:
            die(f"Server beendet sich (Exit {proc.returncode}), siehe {state_dir / 'serve.log'}")
        if http_ok(base) and proc.poll() is None:   # antwortet unser eigener Prozess (nicht ein Fremdserver auf demselben Port)?
            break
        time.sleep(0.5)
    else:
        os.killpg(proc.pid, signal.SIGTERM)
        die("Server startet nicht rechtzeitig")
    url = f"http://localhost:{port}/{quote(md.name)}"
    (state_dir / "serve.json").write_text(json.dumps({"pid": proc.pid, "port": port, "url": url}))
    print(f"Server läuft: {url}")
    print("Änderungen an der .md werden live nachgeladen. Stoppen: marp-deck serve --stop")


# ── export ─────────────────────────────────────────────────────────────────

URL_RE = re.compile(r"""url\((?P<q>&quot;|["'])?(?P<p>[^)"'&]+?)(?P=q)?\)""")
SRC_RE = re.compile(r"""(?P<pre>\bsrc=)(?P<q>["'])(?P<p>[^"']+)(?P=q)""")


def inline_local_assets(html, deck):
    """Bettet lokale Dateien (Bilder, Hintergründe) als Data-URI ein → eine einzige, portable HTML-Datei."""
    deck = deck.resolve()
    cache, missing = {}, []

    def data_uri(rel):
        if re.match(r"^(https?:|data:|#|//|mailto:)", rel):
            return None
        rel = unquote(rel)
        path = (deck / rel).resolve()
        if not path.is_relative_to(deck) or not path.is_file():
            missing.append(rel)
            return None
        if path not in cache:
            mime = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
            cache[path] = f"data:{mime};base64," + base64.b64encode(path.read_bytes()).decode()
        return cache[path]

    def sub_src(m):
        uri = data_uri(m["p"])
        return m[0] if uri is None else f"{m['pre']}{m['q']}{uri}{m['q']}"

    def sub_url(m):
        uri = data_uri(m["p"])
        if uri is None:
            return m[0]
        q = m["q"] or ""
        return f"url({q}{uri}{q})"

    html = SRC_RE.sub(sub_src, html)
    html = URL_RE.sub(sub_url, html)
    return html, missing


def cmd_export(a):
    deck = find_deck(a.deck)
    ensure_trusted_config(deck, a.trust_config)
    md = deck_md(deck)
    ext = a.format
    out = Path(a.output).expanduser().resolve() if a.output else deck / "dist" / f"{md.stem}.{ext}"
    out.parent.mkdir(parents=True, exist_ok=True)
    args = ["-c", "marp.config.mjs"]
    if ext == "pdf":
        args.append("--pdf")
    elif ext == "pptx":
        args.append("--pptx")
    args += ["-o", str(out), md.name]
    run_marp(args, cwd=deck)
    if ext == "html":
        html, missing = inline_local_assets(out.read_text(), deck)
        out.write_text(html)
        for rel in sorted(set(missing)):
            print(f"WARNUNG: lokale Datei nicht eingebettet (fehlt oder außerhalb des Decks): {rel}", file=sys.stderr)
    size = out.stat().st_size / 1024
    note = {"pdf": "mit Notizen und Gliederung", "pptx": "nur Bilder der Folien, nicht editierbar",
            "html": "eine Datei, Presenter View mit Taste P"}[ext]
    print(f"{out} ({size:.0f} KB) — {note}")


# ── pack / unpack (.deck = ZIP des Deck-Ordners + manifest.json) ───────────

DECK_FORMAT, DECK_FORMAT_VERSION = "marp-deck", 1
PACK_SKIP_DIRS = {"dist", ".marp-deck", "node_modules", ".git"}
MAX_PACK_ENTRIES = 5000
MAX_PACK_BYTES = 512 * 1024 * 1024


def safe_member(name, root):
    """Prüft einen ZIP-Eintragsnamen; gibt den Zielpfad zurück (immer unterhalb von root) oder wirft ValueError."""
    if not name or name.startswith(("/", "\\")) or "\\" in name or re.match(r"^[A-Za-z]:", name) or "\x00" in name:
        raise ValueError(f"unzulässiger Pfad im Archiv: {name!r}")
    parts = name.split("/")
    if any(p in ("..", "") for p in parts[:-1]) or parts[-1] == "..":
        raise ValueError(f"unzulässiger Pfad im Archiv: {name!r}")
    dest = (root / name).resolve()
    if not dest.is_relative_to(root.resolve()):
        raise ValueError(f"Pfad verlässt den Zielordner: {name!r}")
    return dest


def valid_deck_name(name):
    return isinstance(name, str) and bool(name) and name not in (".", "..") and not re.search(r"[/\\\x00]", name)


def cmd_pack(a):
    deck = find_deck(a.deck)
    out = Path(a.output).expanduser().resolve() if a.output else deck.parent / f"{deck.name}.deck"
    if out.exists() and not a.force:
        die(f"{out} existiert bereits (--force zum Überschreiben)")
    snap = deck / "theme" / "brand" / "brand.json"
    brand = json.loads(snap.read_text())["name"] if snap.is_file() else None
    files = []
    for p in sorted(deck.rglob("*")):
        rel = p.relative_to(deck)
        if any(part in PACK_SKIP_DIRS for part in rel.parts):
            continue
        if p.is_symlink():
            print(f"WARNUNG: Symlink übersprungen: {rel}", file=sys.stderr)
            continue
        if p.is_file():
            files.append(p)
    if len(files) > MAX_PACK_ENTRIES:
        die(f"zu viele Dateien ({len(files)} > {MAX_PACK_ENTRIES})")
    manifest = {"format": DECK_FORMAT, "version": DECK_FORMAT_VERSION, "name": deck.name, "brand": brand,
                "created": datetime.now(timezone.utc).isoformat(timespec="seconds"), "files": len(files)}
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(out.suffix + ".tmp")
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED, strict_timestamps=False) as z:   # mtime vor 1980 erlauben
            z.writestr("manifest.json", json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
            for p in files:
                z.write(p, f"{deck.name}/{p.relative_to(deck).as_posix()}")
        tmp.replace(out)
    finally:
        tmp.unlink(missing_ok=True)
    print(f"{out} ({out.stat().st_size / 1024:.0f} KB, {len(files)} Dateien, Brand '{brand}')")
    if (deck / "theme" / "brand" / "fonts").is_dir():
        print("Hinweis: das Deck enthält Schriftdateien — Lizenz prüfen, bevor du es weitergibst.")


def cmd_unpack(a):
    src = Path(a.file).expanduser()
    if not src.is_file():
        die(f"{src} nicht gefunden")
    try:
        z = zipfile.ZipFile(src)
    except zipfile.BadZipFile:
        die(f"{src} ist kein gültiges Archiv")
    with z:
        try:
            manifest = json.loads(z.read("manifest.json"))
        except (KeyError, ValueError):
            die("kein gültiges .deck: manifest.json fehlt oder ist defekt")
        if manifest.get("format") != DECK_FORMAT:
            die(f"kein marp-deck-Archiv (format={manifest.get('format')!r})")
        if manifest.get("version", 0) > DECK_FORMAT_VERSION:
            die(f"Archivversion {manifest['version']} ist neuer als unterstützt ({DECK_FORMAT_VERSION}) — Skill aktualisieren")
        name = manifest.get("name")
        if not valid_deck_name(name):
            die(f"unzulässiger Deck-Name im Manifest: {name!r}")
        infos = [i for i in z.infolist() if i.filename != "manifest.json"]
        if len(infos) > MAX_PACK_ENTRIES:
            die("Archiv hat zu viele Einträge")
        if sum(i.file_size for i in infos) > MAX_PACK_BYTES:
            die("Archiv ist entpackt zu groß")
        parent = Path(a.dir).expanduser().resolve() if a.dir else Path.cwd()
        target = parent / name
        if target.exists():
            die(f"{target} existiert bereits — nichts überschrieben")
        # Erst alles prüfen, dann schreiben: ein manipuliertes Archiv hinterlässt nichts.
        plan = []
        for i in infos:
            if not i.filename.startswith(name + "/"):
                die(f"Eintrag außerhalb von {name}/: {i.filename!r}")
            rel_parts = i.filename[len(name) + 1:].split("/")
            if rel_parts[0] in PACK_SKIP_DIRS:      # Zustand/Build/Git gehören nicht in ein weitergegebenes Deck
                continue
            if rel_parts[0] == ".vscode" and rel_parts != [".vscode", "settings.json"]:   # tasks.json, launch.json … sind ausführbar
                continue
            if (i.external_attr >> 16) & 0o170000 == 0o120000:
                die(f"Symlink im Archiv abgelehnt: {i.filename!r}")
            try:
                dest = safe_member(i.filename, parent)
            except ValueError as e:
                die(str(e))
            plan.append((i, dest))
        if not any(i.filename == f"{name}/marp.config.mjs" for i in infos):
            die("kein Deck: marp.config.mjs fehlt im Archiv")
        written = 0
        try:
            for i, dest in plan:
                if i.is_dir():
                    dest.mkdir(parents=True, exist_ok=True)
                    continue
                dest.parent.mkdir(parents=True, exist_ok=True)
                if i.filename == f"{name}/marp.config.mjs":     # nie fremden Code übernehmen: Standard-Config statt Archivinhalt
                    dest.write_text(CONFIG)
                    continue
                if i.filename == f"{name}/.vscode/settings.json":   # Workspace-Einstellungen können Programme starten: Standard statt Archivinhalt
                    dest.write_text(VSCODE_SETTINGS)
                    continue
                with z.open(i) as fin, open(dest, "wb") as fout:
                    while chunk := fin.read(1 << 20):
                        written += len(chunk)
                        if written > MAX_PACK_BYTES:
                            raise RuntimeError("Archiv ist entpackt zu groß")
                        fout.write(chunk)
        except Exception:
            shutil.rmtree(target, ignore_errors=True)   # nur das, was dieser Lauf angelegt hat (target existierte vorher nicht)
            raise
    print(f"Deck entpackt: {target}")
    print(f"  Brand: {manifest.get('brand')} · {manifest.get('files')} Dateien · Vorschau: marp-deck serve {target}")


# ── brand ──────────────────────────────────────────────────────────────────

def brand_store():
    store = os.environ.get("MARP_BRANDS_DIR")
    return Path(store).expanduser() if store else Path.home() / ".config" / "marp-presentation" / "brands"


def _load(name):
    spec = importlib.util.spec_from_file_location(name, HERE / f"{name}.py")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


# ── suggest ────────────────────────────────────────────────────────────────

DATE_PREFIX = re.compile(r"^(\d{4})-(\d{2})-(\d{2})[-_ ]")
DECK_DIR_NAMES = ("presentations", "praesentationen", "präsentationen", "slides", "decks", "talks", "vortraege", "vorträge",
                  "workshops", "folien")


def project_root(start):
    """Projektwurzel: nächster Ordner mit .git oberhalb von start, sonst start selbst (nie oberhalb des Home-Ordners)."""
    start = Path(start).resolve()
    home = Path.home().resolve()
    for p in [start, *start.parents]:
        if (p / ".git").exists():
            return p
        if p == home or p == p.parent:
            break
    return start


def suggest(title, project=None, date=None):
    root = project_root(project or Path.cwd())
    decks = list(find_decks(root, max_depth=6))
    reasons, alternatives = [], []
    target_dir = None
    if decks:
        from collections import Counter
        count = Counter(d.parent for d in decks)
        newest = {p: max(d.stat().st_mtime for d in decks if d.parent == p) for p in count}
        target_dir = sorted(count, key=lambda p: (-count[p], -newest[p]))[0]
        reasons.append(f"{count[target_dir]} vorhandene(s) Deck(s) liegen bereits in {target_dir.relative_to(root) if target_dir != root else '.'}")
        alternatives = [p for p in sorted(count, key=lambda p: (-count[p], -newest[p]))[1:4]]
    else:
        for p in sorted(root.rglob("*"), key=lambda p: len(p.parts)):
            if p.is_dir() and p.name.lower() in DECK_DIR_NAMES and not any(x in {"node_modules", ".git", "dist"} for x in p.parts):
                if len(p.relative_to(root).parts) <= 3:
                    target_dir = p
                    reasons.append(f"Ordner „{p.relative_to(root)}“ existiert und passt zum Zweck")
                    break
        if target_dir is None:
            target_dir = root / "presentations"
            reasons.append("kein Präsentationsordner gefunden: neuer Ordner „presentations“ in der Projektwurzel (wird beim Anlegen erzeugt)")

    # Namensschema aus vorhandenen Decks ableiten: Datumspräfix, Groß-/Kleinschreibung
    names = [d.name for d in decks if d.parent == target_dir] or [d.name for d in decks]
    dated = [n for n in names if DATE_PREFIX.match(n)]
    use_date = bool(dated) and len(dated) * 2 >= len(names)
    keep_case = any(re.search(r"[A-ZÄÖÜ]", DATE_PREFIX.sub("", n)) for n in names)
    today = date or time.strftime("%Y-%m-%d")
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", today):
        die(f"--date: JJJJ-MM-TT erwartet, nicht {today!r}")
    core = slugify(title, lower=not keep_case) or "praesentation"
    slug = f"{today}-{core}" if use_date else core
    if names:
        reasons.append("Namensschema aus vorhandenen Decks: " + ("Datum-Präfix, " if use_date else "ohne Datum, ") +
                       ("Großschreibung bleibt erhalten" if keep_case else "kleingeschrieben"))
    else:
        reasons.append("kein Schema ableitbar: Titel in Kleinbuchstaben (mit --date und Präfix selbst festlegen, falls gewünscht)")
    base, n = slug, 2
    while (target_dir / slug).exists():
        slug = f"{base}-{n}"; n += 1
    if slug != base:
        reasons.append(f"„{base}“ existiert bereits: {slug}")
    return {"project": str(root), "dir": str(target_dir), "slug": slug, "path": str(target_dir / slug), "reasons": reasons,
            "creates_dir": not target_dir.exists(), "alternatives": [str(a) for a in alternatives],
            "command": f'marp-deck new "{title}" --dir "{target_dir}" --slug "{slug}"'}


def cmd_suggest(a):
    title = " ".join(a.title).strip()
    if not title:
        die("Titel angeben")
    res = suggest(title, a.project, a.date)
    if a.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return
    rel = lambda p: os.path.relpath(p, res["project"])
    print(f"Vorschlag: {rel(res['path'])}/")
    print(f"  Projekt:  {res['project']}")
    for r in res["reasons"]:
        print(f"  - {r}")
    if res["alternatives"]:
        print("  Andere Ablageorte mit Decks: " + ", ".join(rel(p) for p in res["alternatives"]))
    print(f"  Anlegen mit: {res['command']}")


# ── vscode ─────────────────────────────────────────────────────────────────

def parse_jsonc(text):
    """settings.json ist JSON mit Kommentaren und nachgestellten Kommas. -> (Objekt, enthält_Kommentare)"""
    out, i, n, in_str, esc, had_comment = [], 0, len(text), False, False, False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True; out.append(c)
        elif text.startswith("//", i):
            had_comment = True
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            had_comment = True
            end = text.find("*/", i + 2)
            i = n if end == -1 else end + 2
            continue
        elif c == ",":                       # nachgestelltes Komma (nur außerhalb von Strings) auslassen
            j = i + 1
            while j < n and text[j] in " \t\r\n":
                j += 1
            if j < n and text[j] in "}]":
                i += 1
                continue
            out.append(c)
        else:
            out.append(c)
        i += 1
    return json.loads("".join(out)), had_comment


def find_decks(root, max_depth=4):
    skip = {"node_modules", ".git", "dist", ".marp-deck", ".vscode", "theme"}
    root = Path(root)
    for dirpath, dirnames, files in os.walk(root):
        depth = len(Path(dirpath).relative_to(root).parts)
        dirnames[:] = sorted(d for d in dirnames if d not in skip) if depth < max_depth else []
        if "marp.config.mjs" in files and (Path(dirpath) / "theme" / "theme.css").is_file():
            yield Path(dirpath)


def theme_name(css_path):
    mt = re.search(r"/\*\s*@theme\s+(\S+)\s*\*/", Path(css_path).read_text(errors="replace")[:4000])
    return mt.group(1) if mt else None


def cmd_vscode(a):
    project = Path(a.project).expanduser().resolve() if a.project else Path.cwd().resolve()
    if not project.is_dir():
        die(f"{project} ist kein Ordner")
    decks = list(find_decks(project))
    if not decks:
        die(f"keine Decks unter {project} gefunden (erwartet: marp.config.mjs und theme/theme.css)")
    wanted = [d.joinpath("theme", "theme.css").relative_to(project).as_posix() for d in decks]
    sfile = project / ".vscode" / "settings.json"
    settings, notes = {}, []
    if sfile.is_file():
        try:
            settings, had_comments = parse_jsonc(sfile.read_text())
        except ValueError as e:
            die(f"{sfile} ist kein lesbares JSON ({e}) — nichts verändert")
        if not isinstance(settings, dict):
            die(f"{sfile}: Wurzel ist kein Objekt — nichts verändert")
        if had_comments:   # Kommentare gingen beim Zurückschreiben verloren: nicht anfassen, Zeilen zum Einfügen ausgeben
            snippet = json.dumps({VSCODE_THEMES_KEY: wanted, VSCODE_HTML_KEY: "all", **VSCODE_DEFAULTS}, indent=4, ensure_ascii=False)
            print(f"{sfile} enthält Kommentare; ich schreibe sie nicht um. Diese Einträge von Hand ergänzen:\n{snippet}")
            return 3
    current = settings.get(VSCODE_THEMES_KEY, [])
    if not isinstance(current, list):
        die(f"{sfile}: {VSCODE_THEMES_KEY} ist keine Liste — nichts verändert")
    norm = lambda p: p[2:] if isinstance(p, str) and p.startswith("./") else p
    have = {norm(p) for p in current if isinstance(p, str)}
    added = [w for w in wanted if w not in have]
    themes = current + added
    # fehlende Dateien und gleichnamige Themes mit unterschiedlichem Inhalt melden
    import hashlib
    seen = {}
    for p in themes:
        if not isinstance(p, str) or re.match(r"^https?:", p):
            continue
        f = project / norm(p)
        if not f.is_file():
            notes.append(f"Eintrag verweist auf fehlende Datei: {p}")
            continue
        nm = theme_name(f)
        digest = hashlib.sha256(f.read_bytes()).hexdigest()[:8]
        if nm in seen and seen[nm][1] != digest:
            notes.append(f"Theme '{nm}' kommt in {seen[nm][0]} und {p} mit unterschiedlichem Inhalt vor — die Erweiterung nimmt still den "
                         f"letzten. Abhilfe: in den Decks `marp-deck brand sync` ausführen.")
        seen.setdefault(nm, (p, digest))
    new = dict(settings)
    new[VSCODE_THEMES_KEY] = themes
    html_changed = new.get(VSCODE_HTML_KEY) != "all"
    new[VSCODE_HTML_KEY] = "all"
    for k, v in VSCODE_DEFAULTS.items():
        new.setdefault(k, v)
    changed = new != settings
    quiet = getattr(a, "quiet", False)
    if not quiet:
        print(f"{len(decks)} Deck(s) gefunden:")
        for d in decks:
            print(f"  {d.relative_to(project) if d != project else '.'}  (Theme '{theme_name(d / 'theme' / 'theme.css')}')")
    if not changed:
        if quiet:
            return 0
        print(f"{sfile}: bereits aktuell.")
    elif a.dry_run:
        print(f"[Probelauf] würde {sfile} ändern: {len(added)} Theme(s) ergänzen" + (", markdown.marp.html auf \"all\" setzen" if html_changed else ""))
    else:
        sfile.parent.mkdir(exist_ok=True)
        if sfile.is_file():
            shutil.copy2(sfile, sfile.with_name(f"settings.json.bak-{time.strftime('%Y%m%d-%H%M%S')}"))
        sfile.write_text(json.dumps(new, indent=4, ensure_ascii=False) + "\n")
        print(f"{sfile} aktualisiert: {len(added)} Theme(s) ergänzt" + (", markdown.marp.html auf \"all\" gesetzt (nötig für die Komponenten)" if html_changed else "") + ".")
    for n in notes:
        print(f"WARNUNG: {n}", file=sys.stderr)
    if not quiet:
        print(f"Hinweis: {project} als Ordner in VS Code öffnen und dem Workspace vertrauen (sonst ignoriert die Erweiterung Themes und HTML).")
    return 0


def registered_project_for(deck):
    """Nächster Ordner oberhalb des Decks, dessen .vscode/settings.json bereits Marp-Themes listet (früher mit `marp-deck vscode` angelegt)."""
    home = Path.home().resolve()
    for parent in list(deck.resolve().parents)[:8]:
        if parent == home or parent == parent.parent:
            break
        f = parent / ".vscode" / "settings.json"
        if f.is_file():
            try:
                data, _ = parse_jsonc(f.read_text())
            except ValueError:
                continue
            if isinstance(data, dict) and isinstance(data.get(VSCODE_THEMES_KEY), list):
                return parent
    return None


def auto_register(deck):
    """Neues Deck im bereits registrierten Projektordner automatisch eintragen; sonst nur ein Hinweis."""
    project = registered_project_for(deck)
    if project is None:
        print(f"  VS Code: Ordner {deck.name} öffnen, oder im Projektordner `marp-deck vscode <projekt>` (einmalig, danach automatisch)")
        return
    code = cmd_vscode(argparse.Namespace(project=str(project), dry_run=False, quiet=True))
    if code == 0:
        print(f"  VS Code: in {project / '.vscode' / 'settings.json'} eingetragen")
    else:
        print(f"  VS Code: {project / '.vscode' / 'settings.json'} enthält Kommentare — Eintrag von Hand: marp-deck vscode {project}")


def cmd_import_deck(a):
    di = _load("deck_import")
    src = Path(a.file).expanduser()
    if not src.is_file():
        die(f"{src} nicht gefunden")
    try:
        tool = di.find_tool(a.tool)
    except di.DeckImportError as e:
        die(str(e))
    title = a.title or src.stem.replace("_", " ").replace("-", " ")
    cmd_new(argparse.Namespace(title=[title], brand=a.brand, dir=a.dir, slug=a.slug))
    slug = a.slug or slugify(title)
    deck = (Path(a.dir).expanduser() if a.dir else Path.cwd()).resolve() / slug
    try:
        with tempfile.TemporaryDirectory() as tmp:
            md, roots = di.convert(src, tool, tmp)
            frontmatter, _ = di.split_frontmatter((deck / f"{slug}.md").read_text())
            text, info = di.build_markdown(md.read_text(), frontmatter + "\n", roots, deck / "assets")
    except Exception as e:                           # auch unerwartete Fehler (OSError, …): angelegtes Deck wieder entfernen
        shutil.rmtree(deck, ignore_errors=True)        # das Deck wurde in diesem Lauf angelegt (new lehnt vorhandene Ordner ab)
        die(str(e) if isinstance(e, di.DeckImportError) else f"{type(e).__name__}: {e}")
    (deck / f"{slug}.md").write_text(text)
    print(f"{info['slides']} Folien aus {src.name} übernommen → {deck / (slug + '.md')}")
    print("  Übernommen: Titel, Text, Listen, Tabellen, Bilder, Sprechernotizen. Nicht übernommen: Layout, Diagramme, SmartArt, Animationen.")
    print("  Alle Folien nutzen die Standard-Inhaltsklasse; Abschnitte (`section`), Spalten (`cols`) und Abschluss (`closing`) ordnest du danach zu.")
    if info["blocked_refs"]:
        print(f"  WARNUNG: {len(info['blocked_refs'])} Verweis(e) mit unzulässigem Schema entfernt: {', '.join(info['blocked_refs'][:5])}", file=sys.stderr)
    if info["missing_images"]:
        print(f"  WARNUNG: {len(info['missing_images'])} Bild(er) nicht gefunden: {', '.join(info['missing_images'][:5])}", file=sys.stderr)


def cmd_brand(a):
    if a.sub == "list":
        bt.list_brands(None)
        return
    if a.sub == "showcase":
        sc = _load("pptx_showcase")
        src = Path(a.target)
        out = Path(a.out) if a.out else Path.cwd()
        out.mkdir(parents=True, exist_ok=True)
        n = sc.build(src, out / f"{src.stem}-showcase-leer.pptx")
        sc.build(src, out / f"{src.stem}-showcase-gefuellt.pptx", filled=True)
        print(f"{n} Layouts. Erzeugt in {out}:")
        print(f"  {src.stem}-showcase-leer.pptx       → in PowerPoint als PDF exportieren → brand import --backgrounds <pdf>")
        print(f"  {src.stem}-showcase-gefuellt.pptx   → in PowerPoint als PDF exportieren → brand import --reference <pdf>")
        return
    if a.sub == "import":
        bi = _load("brand_import")
        if not a.name:
            die("--name angeben")
        check_name(a.name, "Brand-Name")
        out = Path(a.out).expanduser() if a.out else brand_store() / a.name
        existed = out.exists()   # nur aufräumen, was dieser Lauf selbst angelegt hat
        replacing = existed and any(out.iterdir()) and a.replace
        target = out.with_name(f"{out.name}.neu-{os.getpid()}") if replacing else out
        try:
            res = bi.import_brand(a.target, a.name, target, a.backgrounds, not a.no_render, dict(m.split("=", 1) for m in a.map),
                                  a.guidelines, a.fonts, a.reference)
            if replacing:
                for keep in ("custom.css", "GUIDELINES.md"):          # Handarbeit übernehmen
                    if (out / keep).is_file() and not (target / keep).exists():
                        shutil.copy2(out / keep, target / keep)
                for keep_dir in ("guidelines", "fonts"):
                    if (out / keep_dir).is_dir() and not (target / keep_dir).exists():
                        shutil.copytree(out / keep_dir, target / keep_dir, symlinks=True)
                old_meta = json.loads((out / "brand.json").read_text())
                new_meta = json.loads((target / "brand.json").read_text())
                if old_meta.get("fonts") and not new_meta.get("fonts"):
                    new_meta["fonts"] = old_meta["fonts"]
                    (target / "brand.json").write_text(json.dumps(new_meta, indent=2, ensure_ascii=False) + "\n")
                backup = out.with_name(f"{out.name}.bak-{time.strftime('%Y%m%d-%H%M%S')}")
                out.rename(backup)
                target.rename(out)
                res["dir"] = str(out)
                print(f"Vorhandener Brand gesichert: {backup}")
        except Exception as e:   # auch unerwartete Fehler: keine halbfertigen Brands hinterlassen
            if replacing or not existed:
                shutil.rmtree(target, ignore_errors=True)
            msg = str(e) if isinstance(e, (bi.ImportError_, bi.px.PptxError, bi.sc.ShowcaseError)) else f"{type(e).__name__}: {e}"
            die(msg + ("\n  (Tipp: --replace ersetzt einen vorhandenen Brand und sichert den alten)" if "nicht leer" in msg else ""))
        print(f"Brand '{res['name']}' angelegt: {res['dir']}")
        print(f"  Hintergründe: {'gerendert (pixelgenau)' if res['mode'] == 'render' else 'aus Grafiken rekonstruiert (angenähert)'}")
        for layout, classes in res["classes"].items():
            print(f"  Layout '{layout}' → {', '.join(classes)}")
        if res["semantic"].get("closing", "").endswith("(wie Titelfolie)"):
            print("  Hinweis: kein Abschluss-Layout gefunden, 'closing' nutzt die Titelfolie (--map closing=<Layoutname> ändert das)")
        for w in res["warnings"]:
            print(f"  WARNUNG: {w}")
        if res["guidelines"]:
            print(f"  Guidelines kopiert ({', '.join(res['guidelines'])}); GUIDELINES.md muss noch ausgewertet werden")
        print("  Nächste Schritte: brand preview/compare prüfen, tokens.css/custom.css bei Bedarf anpassen")
        return
    if a.sub in ("preview", "compare"):
        bp = _load("brand_preview")
        src = bt.resolve(a.target, None)
        if a.sub == "preview":
            out = Path(a.out) if a.out else Path.cwd() / f"{a.target}-vorschau"
            args = argparse.Namespace(title=[f"Vorschau {a.target}"], brand=a.target, dir=str(out.parent), slug=out.name)
            cmd_new(args)
            deck = out.resolve()
            (deck / f"{deck.name}.md").write_text(bp.preview_markdown(bp.load_meta(src)))
            print(f"Vorschau-Deck: {deck} → marp-deck serve {deck}")
            return
        out = Path(a.out) if a.out else Path.cwd() / f"{a.target}-vergleich"
        rows = bp.compare(src, out)
        for r in rows:
            ab = "n/a" if r["abweichung"] is None else f"{r['abweichung'] * 100:.1f} %"
            print(f"  {r['class']:<24} {r['layout']:<24} Abweichung {ab}")
        print(f"Bilder (Original | Marp | Differenz): {out}/*-vergleich.png")
        print("Hinweis: rund 5 % sind Textglättung zwischen den Renderern, kein Layoutfehler.")
        return
    deck = find_deck(a.deck)
    snap = deck / "theme" / "brand"
    if not (snap / "brand.json").is_file():
        die("Deck hat keinen Brand-Snapshot (theme/brand/)")
    name = json.loads((snap / "brand.json").read_text())["name"]
    src = bt.resolve(name, None)  # bewusst ohne Deck: Quelle ist der Store, nicht der Snapshot
    old = (deck / "theme" / "theme.css").read_bytes() if (deck / "theme" / "theme.css").is_file() else b""
    with tempfile.TemporaryDirectory() as tmp:
        bt.build(src, Path(tmp) / "t.css")  # erst prüfen, dann ersetzen
    snapshot_brand(src, deck)
    new = (deck / "theme" / "theme.css").read_bytes()
    print(f"Brand '{name}' aus {src} übernommen — Theme {'unverändert' if old == new else 'aktualisiert'}")


def cmd_doctor(_a):
    sys.exit(subprocess.run([sys.executable, str(HERE / "doctor.py")]).returncode)


def main():
    ap = argparse.ArgumentParser(prog="marp-deck", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)

    n = sp.add_parser("new", help="neues Deck anlegen")
    n.add_argument("title", nargs="+")
    n.add_argument("--brand", default="neutral")
    n.add_argument("--dir")
    n.add_argument("--slug")
    n.set_defaults(fn=cmd_new)

    s = sp.add_parser("serve", help="Live-Vorschau im Browser starten/stoppen")
    s.add_argument("deck", nargs="?")
    s.add_argument("--port", type=int)
    s.add_argument("--stop", action="store_true")
    s.add_argument("--trust-config", action="store_true", help="abweichende marp.config.mjs ausführen (Code!)")
    s.set_defaults(fn=cmd_serve)

    e = sp.add_parser("export", help="als pdf, html oder pptx exportieren")
    e.add_argument("format", choices=["pdf", "html", "pptx"])
    e.add_argument("deck", nargs="?")
    e.add_argument("-o", "--output")
    e.add_argument("--trust-config", action="store_true", help="abweichende marp.config.mjs ausführen (Code!)")
    e.set_defaults(fn=cmd_export)

    rc = sp.add_parser("repair-config", help="Standard-marp.config.mjs wiederherstellen")
    rc.add_argument("deck", nargs="?")
    rc.set_defaults(fn=cmd_repair_config)

    b = sp.add_parser("brand", help="Brands auflisten, importieren (PPTX), vergleichen, Deck-Snapshot aktualisieren")
    b.add_argument("sub", choices=["list", "sync", "showcase", "import", "preview", "compare"])
    b.add_argument("target", nargs="?", help="sync: Deck · showcase/import: PPTX · preview/compare: Brand-Name")
    b.add_argument("--name"); b.add_argument("--out"); b.add_argument("--backgrounds"); b.add_argument("--reference")
    b.add_argument("--guidelines", action="append", default=[]); b.add_argument("--fonts")
    b.add_argument("--map", action="append", default=[]); b.add_argument("--no-render", action="store_true")
    b.add_argument("--replace", action="store_true", help="vorhandenen Brand ersetzen (alter wird gesichert, custom.css/GUIDELINES.md/fonts bleiben)")
    b.set_defaults(fn=lambda a: (setattr(a, "deck", a.target), cmd_brand(a)))

    sg = sp.add_parser("suggest", help="Zielordner und Namen für ein neues Deck vorschlagen (schreibt nichts)")
    sg.add_argument("title", nargs="+")
    sg.add_argument("--project")
    sg.add_argument("--date")
    sg.add_argument("--json", action="store_true")
    sg.set_defaults(fn=cmd_suggest)

    vs = sp.add_parser("vscode", help="Marp for VS Code: Themes und HTML-Einstellung eintragen")
    vs.add_argument("project", nargs="?")
    vs.add_argument("--dry-run", action="store_true")
    vs.set_defaults(fn=lambda a: sys.exit(cmd_vscode(a) or 0))

    ii = sp.add_parser("import-deck", help="bestehende PPTX-Präsentation als Marp-Deck übernehmen (braucht pptx2md)")
    ii.add_argument("file")
    ii.add_argument("--brand", default="neutral")
    ii.add_argument("--title")
    ii.add_argument("--dir")
    ii.add_argument("--slug")
    ii.add_argument("--tool")
    ii.set_defaults(fn=cmd_import_deck)

    pk = sp.add_parser("pack", help="Deck als .deck (ZIP) packen")
    pk.add_argument("deck", nargs="?")
    pk.add_argument("-o", "--output")
    pk.add_argument("--force", action="store_true")
    pk.set_defaults(fn=cmd_pack)

    up = sp.add_parser("unpack", help=".deck entpacken")
    up.add_argument("file")
    up.add_argument("--dir")
    up.set_defaults(fn=cmd_unpack)

    d = sp.add_parser("doctor", help="Voraussetzungen prüfen")
    d.set_defaults(fn=cmd_doctor)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
